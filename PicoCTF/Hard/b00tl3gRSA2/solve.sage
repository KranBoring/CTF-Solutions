from Crypto.Util.number import *
from sage.all import *

N = 
e = 
ciphertext = 

def wiener(N,e):
    N = ZZ(N)
    e = ZZ(e)
    cf = continued_fraction(e / N)
    for conv in cf.convergents():
        k = conv.numerator()
        d = conv.denominator()

        if k == 0 or (e * d - 1) % k != 0:
            continue
        T = (e * d - 1) // k
        s = N - T + 1

        R.<x> = PolynomialRing(ZZ)
        P = x^2 - s * x + N

        roots = P.roots()
        if len(roots) == 2:
            return d 

d = wiener(N, e)
flag = long_to_bytes(pow(ciphertext, d, N))
print(flag)


        

