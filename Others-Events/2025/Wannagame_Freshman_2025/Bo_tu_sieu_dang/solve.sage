from sage.all import *
from Crypto.Util.number import *

c = 
e = 0x10001
m1 = 2**1024 - 3
m2 = 2**1022 - 2
m3 = 2**1020 - 1
m4 = 2**1018

factors = [
    13,
    107,
    87671,
    3870037838243,
    279462107025143615623321823017,
    1325706410421371952032007611396267
]

for k0 in range(5):
    for k1 in range(5):
        for k2 in range(5):
            ciphertext = c + k0 * m4 + k1 * m3 + k2 * m2

            m = [pow(ciphertext, pow(e, -1, factor - 1), factor)for factor in factors]
            flag = long_to_bytes(int(crt(m, factors)))
            if flag.startswith(b"W1{"):
                print(flag)
                break